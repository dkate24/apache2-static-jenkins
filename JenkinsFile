pipeline{
    agent any

    stages{
        stage("Checkout"){
            steps{
                echo 'Checking out...'
                checkout scm
            }
        }
        stage('Build'){
            steps{
                echo 'Building...'
                sh 'test -f index.html'
            }
        }

        stage('Deploy'){
            steps{
                echo 'Deploying...'
                sh '''
                    sudo rm -rf /var/www/html/*
                    sudo cp -r ./* /var/www/html/
                '''
            }
        }

        stage('Restart Apache') {
            steps {
                echo 'Reloading Apache2...'
                sh 'sudo systemctl reload apache2'
            }
        }
        

    }
    post{
        success{
            echo 'Pipeline completed successfully!'
        }
        failure{
            echo 'Pipeline failed!'
        }
    }
}